# Muirakitan RE - Ghidra Analysis Sandbox
# Based on mcp-base with Ghidra and Java 17

FROM muirakitan/mcp-base:latest

USER root

ENV DEBIAN_FRONTEND=noninteractive

# Install OpenJDK 17 (required for Ghidra 11+)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    ant \
    && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Download and install Ghidra (using latest stable release)
ARG GHIDRA_VERSION=11.2_PUBLIC
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}/ghidra_${GHIDRA_VERSION}_20240702.zip

RUN cd /opt && \
    wget -q "${GHIDRA_URL}" -O ghidra.zip && \
    unzip -q ghidra.zip && \
    rm ghidra.zip && \
    mv ghidra_* ghidra && \
    chown -R muirakitan:muirakitan /opt/ghidra

# Create Ghidra project directory
RUN mkdir -p /sandbox/ghidra-projects && \
    chown -R muirakitan:muirakitan /sandbox/ghidra-projects

# Install Python packages for Ghidra scripting
RUN pip3 install --no-cache-dir \
    pyghidra \
    lxml \
    requests

USER muirakitan

# Ghidra environment variables
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
ENV PATH=$GHIDRA_INSTALL_DIR/support:$PATH

# Create Ghidra script directory
RUN mkdir -p /sandbox/scripts/ghidra

WORKDIR /sandbox

CMD ["/bin/bash"]